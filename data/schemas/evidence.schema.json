{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence.schema.json",
  "title": "aOS Evidence Packet (Tier C)",
  "description": "Volatile, replaceable evidence backing a product placement or concept claim.",
  "type": "object",
  "required": ["id", "productId", "type", "status"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ev-[a-z0-9-]+$",
      "description": "Globally unique evidence ID. Convention: ev-<productId>-<seq>."
    },
    "productId": {
      "type": "string",
      "description": "The product this evidence supports."
    },
    "type": {
      "type": "string",
      "enum": [
        "repo-analysis",
        "doc-review",
        "benchmark",
        "user-report",
        "vendor-claim",
        "community-signal"
      ],
      "description": "What kind of evidence this is."
    },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "sourceUrl": {
      "type": "string",
      "format": "uri",
      "description": "Original source URL (repo, blog, paper)."
    },
    "sourceType": {
      "type": "string",
      "enum": [
        "github-repo",
        "documentation",
        "blog-post",
        "paper",
        "benchmark-suite",
        "social-signal"
      ]
    },
    "sourceQuality": {
      "type": "string",
      "enum": ["unknown", "low", "medium", "high"]
    },
    "trustLevel": {
      "type": "string",
      "enum": ["unverified", "automated", "verified-manual", "expert-reviewed"],
      "description": "How this evidence was verified."
    },
    "capturedDate": {
      "type": "string",
      "format": "date"
    },
    "expiresDate": {
      "type": ["string", "null"],
      "format": "date",
      "description": "When this evidence should be considered stale. Null = no expiry."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim"],
        "properties": {
          "claim": { "type": "string" },
          "evidence": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      },
      "description": "Specific factual claims this packet supports."
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Concept slugs and free-form tags for discovery."
    },
    "status": {
      "type": "string",
      "enum": ["active", "expired", "superseded", "stub"]
    },
    "lastReviewed": {
      "type": ["string", "null"],
      "format": "date"
    },
    "reviewedBy": {
      "type": ["string", "null"],
      "enum": ["manual", "automated", null]
    }
  }
}
